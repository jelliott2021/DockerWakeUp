{
  // Type-checks the tests together with the sources (used by ts-jest and
  // `npm run typecheck`); the build itself uses tsconfig.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    "noEmit": true
  },
  "include": ["generate.ts", "src/**/*", "test/**/*"]
}
