    {
      "name": "Proxy: host-routed request passes the path through",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Host",
            "value": "{{upHost}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/items?x=1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "items"],
          "query": [
            {
              "key": "x",
              "value": "1"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('path untouched, Host rewritten to the target', () => {",
              "  pm.expect(body.url).to.equal('/api/items?x=1');",
              "  pm.expect(body.headers.host).to.equal('127.0.0.1:' + pm.variables.get('upPort'));",
              "});"
            ]
          }
        }
      ]
    },
