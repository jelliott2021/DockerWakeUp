            ]
          }
        }
      ]
    },
    {
      "name": "Failed wake: status reports the failure",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Host",
            "value": "{{neverHost}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/__wake/status",
          "host": ["{{baseUrl}}"],
          "path": ["__wake", "status"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "const attempts = Number(pm.variables.get('neverPolls') || 0) + 1;",
              "pm.variables.set('neverPolls', attempts);",
              "if (!(body.state === 'failed') && attempts < 60) {",
              "  setTimeout(() => {}, 250); // brief pause before polling again",
              "  pm.execution.setNextRequest(\"Failed wake: status reports the failure\");",
              "  return;",
              "}",
              "pm.test('status became the expected state within 60 polls', () => pm.expect(body.state === 'failed', JSON.stringify(body)).to.be.true);",
              "pm.test('carries the error', () => pm.expect(body.error).to.include('Command failed'));",
              "pm.test('not ready', () => pm.expect(body.ready).to.be.false);"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "domain",
      "value": "test.local"
    }
  ]
}
