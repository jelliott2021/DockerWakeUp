{
  "info": {
    "name": "DockerWakeUp wake proxy",
    "description": "API tests for the wake proxy: health check, wake status endpoints, proxying, and the sleeping-service behaviours (wake page, Retry-After, wait-and-replay, failure reporting).\n\nRun with `npm run test:api` (starts a proxy on free ports and runs this collection with newman), or import it into Postman together with an environment providing baseUrl, domain, upHost, upPort, sleepyHost, dozyHost, customHost and neverHost (see test/api/run.ts for the values).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health: local check reports the service count",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/healthz",
          "host": ["{{baseUrl}}"],
          "path": ["healthz"]
        },
        "description": "Direct local requests get the full detail (service count, update check)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('ok with service count and update info', () => {",
              "  pm.expect(body.ok).to.be.true;",
              "  pm.expect(body.services).to.equal(5);",
              "  pm.expect(body.update).to.have.all.keys('localCommit', 'latestCommit', 'updateAvailable', 'checkedAt');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Health: forwarded requests get no detail",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Forwarded-For",
            "value": "203.0.113.9"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/healthz",
          "host": ["{{baseUrl}}"],
          "path": ["healthz"]
