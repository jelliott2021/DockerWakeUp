              "if (!(body.ready === true) && attempts < 60) {",
              "  setTimeout(() => {}, 250); // brief pause before polling again",
              "  pm.execution.setNextRequest(\"Sleeping service: poll dozy until ready\");",
              "  return;",
              "}",
              "pm.test('status became the expected state within 60 polls', () => pm.expect(body.ready === true, JSON.stringify(body)).to.be.true);"
            ]
