    {
      "name": "Sleeping service: POST is refused with Retry-After and starts the wake",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Host",
            "value": "{{sleepyHost}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/thing",
          "host": ["{{baseUrl}}"],
          "path": ["api", "thing"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"hello\": \"world\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Non-idempotent requests cannot be replayed, so they are refused immediately while the service wakes."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 503', () => pm.response.to.have.status(503));",
              "pm.test('Retry-After: 15', () => pm.expect(pm.response.headers.get('Retry-After')).to.equal('15'));",
              "pm.test('explains the wake', () => pm.expect(pm.response.json().error).to.include('sleepy is starting up'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Sleeping service: poll until ready",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Host",
            "value": "{{sleepyHost}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/__wake/status",
          "host": ["{{baseUrl}}"],
          "path": ["__wake", "status"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "const attempts = Number(pm.variables.get('sleepyPolls') || 0) + 1;",
              "pm.variables.set('sleepyPolls', attempts);",
              "if (!(body.ready === true && body.state === 'ready') && attempts < 60) {",
              "  setTimeout(() => {}, 250); // brief pause before polling again",
              "  pm.execution.setNextRequest(\"Sleeping service: poll until ready\");",
              "  return;",
              "}",
              "pm.test('status became the expected state within 60 polls', () => pm.expect(body.ready === true && body.state === 'ready', JSON.stringify(body)).to.be.true);",
              "pm.test('wake duration recorded', () => pm.expect(body.expectedMs).to.be.a('number').above(0));",
              "pm.test('startedAt is a timestamp', () => pm.expect(body.startedAt).to.be.a('number'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Sleeping service: requests now reach it",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Host",
            "value": "{{sleepyHost}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/thing",
          "host": ["{{baseUrl}}"],
          "path": ["api", "thing"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('answered by the woken service', () => {",
              "  pm.expect(body.name).to.equal('sleepy');",
              "  pm.expect(body.url).to.equal('/api/thing');",
              "});"
            ]
          }
        }
      ]
    },
