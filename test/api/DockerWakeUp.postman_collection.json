            "value": "{{upHost}}"
          },
          {
            "key": "X-Forwarded-Host",
            "value": "{{upHost}}"
          },
          {
            "key": "X-Forwarded-Proto",
            "value": "https"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": []
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const h = pm.response.json().headers;",
              "pm.test('X-Forwarded-* preserved', () => {",
              "  pm.expect(h.host).to.equal(pm.variables.get('upHost'));",
              "  pm.expect(h['x-forwarded-host']).to.equal(pm.variables.get('upHost'));",
              "  pm.expect(h['x-forwarded-proto']).to.equal('https');",
              "});"
            ]
