    {
      "name": "Safe GET waits for a waking service and is replayed",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Host",
            "value": "{{customHost}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/data",
          "host": ["{{baseUrl}}"],
          "path": ["api", "data"]
        },
        "description": "GET/HEAD requests without a browser Accept header are held until the service answers, then replayed once."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('answered by the service after the wake', () => pm.expect(pm.response.json().name).to.equal('custom'));",
              "pm.test('took a wake, not a cached answer', () => pm.expect(pm.response.responseTime).to.be.above(50));"
            ]
          }
        }
      ]
    },
