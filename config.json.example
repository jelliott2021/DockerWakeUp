{
  "proxyPort": 8080,
  "idleThreshold": 259200,
  "domain": "example.com",
  "services": [
    {
      "route": "jellyfin",
      "target": "http://localhost:8096",
      "composeDir": "/home/youruser/jellyfin"
    },
    {
      "route": "portainer",
      "target": "http://localhost:9000",
      "composeDir": "/home/youruser/portainer",
      "autoOff": false
    },
    {
      "route": "photos",
      "target": "http://localhost:2283",
      "composeDir": "/home/youruser/immich-app",
      "wakePage": "examples/custom-wake-page.html"
    },
    {
      "route": "minecraft",
      "type": "tcp",
      "listenPort": 25566,
      "target": "localhost:25565",
      "composeDir": "/home/youruser/minecraft"
    },
    {
      "route": "myapp",
      "target": "http://localhost:3000",
      "composeDir": "/home/youruser/myapp",
      "showLogs": false,
      "startCommand": "./prepare-mounts.sh",
      "stopCommand": "./backup-data.sh",
      "logsCommand": "tail -f logs/app.log"
    }
  ]
}
