{
  "name": "wake-proxy",
  "version": "1.0.0",
  "description": "DockerWakeUp wake proxy: routes requests to Docker services, starts them on demand and stops them when idle",
  "license": "MIT",
  "private": true,
  "main": "dist/wake-proxy.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/wake-proxy.js",
    "dev": "ts-node src/wake-proxy.ts",
    "test": "cd .. && npx jest --selectProjects wake-proxy"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "express": "^4.19.2",
    "http-proxy-middleware": "^2.0.6"
  },
  "devDependencies": {
    "@types/connect": "^3.4.38",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.4.5"
  }
}
